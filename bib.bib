	date-modified = {2024-03-10 19:06:39 -0600},
	isbn = {0013-4686},
	journal = {Electrochimica acta},
	keywords = {Algorithm; Computer science; Criteria; EIS; Equivalent circuit; Impedance; Impedance spectrum; Kramers-Kronig; Kramers--Kronig relations; Lithium batteries; Over-fitting; Overfitting; Residual; Robustness; Robustness (computer science); Simulation; Spectra; Standard test; Strategy; Time variance},
