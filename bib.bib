	isbn = {2211-2855;2211-3282;},
	journal = {Nano energy},
	keywords = {Dendrite (crystal); Dendrite-free; Deposition (phase transition); Electrolyte; Inorganic chemistry; Layer (electronics); Li deposition; LiF; Lithium; Materials science; Nanorod; Nucleation; SEI layer; Substrate (electronics); Water additive},
	language = {English},
	pages = {135-144},
	title = {Dendrite-free {Li} deposition using trace-amounts of water as an electrolyte additive},
	volume = {15},
