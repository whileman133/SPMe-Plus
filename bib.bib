@mastersthesis{ChambersSPMs,
	abstract = {This thesis develops and explores the effectiveness of an enhanced single-particle model (SPMe) as a reduced-order model (ROM) to approximate the full-order model (FOM) physics-based equations for both rechargeable lithium-ion battery (LIB) and lithium-metal battery (LMB) cells. The author describes the differences between the two different cell types, discussing the internal structures and underlying functioning mechanisms. Physics-based models are then motivated as a way to determine the internal electrochemical state of the battery cell in order to predict and control aging degradation in addition to the overall cell state-of-charge. The FOM for both LIB and LMB are discussed and how they are unsuitable for implementation within a battery-management system, motivating the necessity for ROMs. The author then develops the SPMe for LIB and LMB by approximating the partial differential equations (PDEs) used in the FOM. Four different state-space models are rigorously derived for approximating the concentrations of the electrodes and electrolyte: finite difference method (FDM), finite volume method (FVM), polynomial approximation (PA), and Pad{\'e} approximation. These approximations are then extended to other cell quantities. Before developing the extended Kalman filter and sigma-point Kalman filter for LIB and LMB, the author shows the augmented state-space systems are unobservable and develops algorithms to resolve the issue. The Kalman filters struggle to estimate the negative electrode concentration for LIB cells whereas this issue is not present for LMB cells. The final effort of this thesis focuses on diagnosing the age of an LMB cell using the interacting-multiple-model Kalman filter. The author shows cell age identification is reliable when the current applied to the cell is dynamic. Constant current inputs are also successful but less reliable than a dynamic current input. The thesis concludes by discussing future avenues of work in regards to the SPMe.},
	author = {Chambers,Craig A.},
	date-added = {2026-03-04 22:40:12 -0700},
	date-modified = {2026-03-04 22:40:12 -0700},
	isbn = {9798346762515},
	keywords = {Computer Engineering; Electrical engineering},
	language = {English},
	title = {Elementary Single Particle Models},
	year = {2024}}

