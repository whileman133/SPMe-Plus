@mastersthesis{MadduxFastCharge,
	abstract = {For many battery modeling and control applications, it is desirable to obtain accurate models of the lithium-ion battery while avoiding cell teardown, an expensive and time-consuming procedure. The application of these models in precise control algorithms is necessary to ensure the safety and health of cell operation. Connecting to these critical applications, this thesis has two objectives. The first is to develop a series of methods to parameterize battery cells without cell teardown using experimental data from simple, cell-level tests. A novel method of finding open-circuit potential (OCP) without cell teardown was pioneered using a literature model of a known positive- or negative-electrode OCP and cell OCV to find an estimate of the other, unknown electrode OCP. This work developed improved methods of parameter optimization for both equivalent circuit models (ECM) and enhanced single-particle models (SPMe). A key outcome of this work is an improved ECM model, termed the blended Enhanced Self-Correcting (ESC) model, that accommodates varying SOC and temperature values throughout various operation points. Furthermore, this thesis presents specialization of the nonlinear Kalman filter to this new ECM model and verifies its application. The second main objective of this thesis was to demonstrate the specialized application of these models for the battery management application of optimal and safe fast-charge using a model predictive control framework. In this work, we also present a redevelopment of the MPC algorithm to eliminate an embedded integrator and incorporate direct-feedthrough of the input signal. This implementation is beneficial for eventual developments in dual-mode MPC. The thesis culminates with a simulation study to demonstrate the effectiveness of using the refined models in the revised MPC framework.},
	author = {Maddux,Kaylie},
	date-added = {2026-03-04 22:40:12 -0700},
	date-modified = {2026-03-04 22:40:12 -0700},
	isbn = {9798346764502},
	keywords = {Computer Engineering; Electrical engineering},
	language = {English},
	school = {University of Colorado Colorado Springs},
	title = {Generating Accurate Models and Fast-Charge Control Algorithms for Lithium-Ion Batteries Using Experimental Data},
	year = {2024}}

