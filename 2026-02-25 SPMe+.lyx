\begin_inset Caption Standard

\begin_layout Plain Layout
Four different implementations of the LTV filter.
\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
Use two filters,
 one for 
\begin_inset Formula $\bar{\theta}_{\mathrm{s}}$
\end_inset

 at 
\begin_inset Formula $\tilde{x}=1$
\end_inset

 and another for 
\begin_inset Formula $\bar{\theta}_{\mathrm{s}}$
\end_inset

 at 
\begin_inset Formula $\tilde{x}=2$
\end_inset


\end_layout

\begin_layout Itemize
Estimate the solid stoichiometries at the edges of the electrodes as:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\theta_{\mathrm{s,avg,r}}^{+}(\tilde{x},t)=\theta_{\mathrm{s,avg}}^{\mathrm{spme}}(t)+\bar{\theta}_{\mathrm{s}}(\tilde{x},t)$
\end_inset

 (exact)
\end_layout

\begin_layout Itemize
\begin_inset Formula $\theta_{\mathrm{ss}}^{+}(\tilde{x},t)=\theta_{\mathrm{ss}}^{\mathrm{spme}}(t)+\bar{\theta}_{\mathrm{s}}(\tilde{x},t)$
\end_inset

 (an approximation)
\end_layout

\end_deeper
\begin_layout Itemize
We estimate the reaction current as follows
\end_layout

\begin_deeper
\begin_layout Itemize
It can be shown that:
\begin_inset Formula 
\begin{align*}
\frac{\partial\theta_{\mathrm{s,avg,r}}(\tilde{x},t)}{\partial t} & =-\frac{\left|\theta_{100}^{\mathrm{p}}-\theta_{0}^{\mathrm{p}}\right|}{3600Q}i_{\mathrm{f}}(\tilde{x},t)
\end{align*}

\end_inset


\end_layout

\begin_layout Itemize
Thus,
 we use the discrete-time approximation:
\begin_inset Formula 
\begin{align*}
i_{\mathrm{f}}^{+}(\tilde{x},kt_{\mathrm{s}}) & =-\frac{3600Q}{\left|\theta_{100}^{\mathrm{p}}-\theta_{0}^{\mathrm{p}}\right|}\frac{\theta_{\mathrm{s,avg,r}}^{+}(\tilde{x},(k+1)t_{\mathrm{s}})-\theta_{\mathrm{s,avg,r}}^{+}(\tilde{x},kt_{\mathrm{s}})}{t_{\mathrm{s}}}
\end{align*}

\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
Finally,
 we seek to compute the electrolyte potential at 
\begin_inset Formula $\tilde{x}=2$
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Assume 
\begin_inset Formula $i_{\mathrm{f}}(\tilde{x},t)$
\end_inset

 follows a quadratic form over the electrode thickness 
\begin_inset Formula $\tilde{x}$
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $i_{\mathrm{f}}(\tilde{x},t)=a\tilde{x}^{2}+b\tilde{x}+c$
\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
We have two points,
 
\begin_inset Formula $i_{\mathrm{1}}\triangleq i_{\mathrm{f}}(1,t)$
\end_inset

 and 
\begin_inset Formula $i_{\mathrm{2}}\triangleq i_{\mathrm{f}}(2,t)$
\end_inset


\end_layout

\begin_layout Itemize
We also know that 
\begin_inset Formula $\intop_{1}^{2}i_{\mathrm{f}}(\tilde{x},t)\,\mathrm{d}\tilde{x}=-i_{\mathrm{app}}(t)$
\end_inset


\end_layout

\begin_layout Itemize
With this,
 we can solve for the three coefficients 
\begin_inset Formula $a$
\end_inset

,
 
\begin_inset Formula $b$
\end_inset

,
 
\begin_inset Formula $c$
\end_inset


\end_layout

\begin_layout Itemize
The PDEs that relate 
\begin_inset Formula $i_{\mathrm{f}}$
\end_inset

 to the electrolyte potential are:
\begin_inset Formula 
\[
\frac{\partial i_{\mathrm{e}}^{\mathrm{r}}}{\partial\tilde{x}}=i_{\mathrm{f+dl}}^{\mathrm{r}},i_{\mathrm{e}}^{\mathrm{r}}=-\bar{\kappa}^{\mathrm{r}}\frac{\partial\phi_{\mathrm{e}}^{\mathrm{r}}}{\partial\tilde{x}}+\bar{W}\bar{\kappa}^{\mathrm{r}}\bar{\psi}T\frac{\partial\theta_{\mathrm{e}}^{\mathrm{r}}}{\partial\tilde{x}}
\]

\end_inset


\end_layout

\begin_layout Itemize
Double integrating over the electrode thickness 
\begin_inset Formula $\tilde{x}$
\end_inset

,
 we can find 
\begin_inset Formula $\phi_{\mathrm{e}}(2,t)$
\end_inset


\end_layout

\begin_layout Itemize
The final result is simple:
\begin_inset Formula 
\begin{align*}
\phi_{\mathrm{e}}^{+}(2,t) & =\phi_{\mathrm{e}}^{\mathrm{spme}}(2,t)+\frac{i_{\mathrm{f}}(2,t)-i_{\mathrm{f}}(1,t)}{12\bar{\kappa}^{\mathrm{p}}}
\end{align*}

\end_inset


\end_layout

\end_deeper
