\begin_layout Section*
The Idea
\end_layout

\begin_layout Itemize
We had success using a one-parameter IIR filter in our PIML models to account for variation in the solid stoichiometry along the thickness of the electrode
\end_layout

\begin_layout Itemize
Let's define 
\begin_inset Formula $\bar{\theta}_{\mathrm{s}}(\tilde{x})\triangleq\theta_{\mathrm{s,avg,r}}(\tilde{x})-\theta_{\mathrm{s,avg}}$
\end_inset

 as the deviation of the particle-average solid stoichiometry at position 
\begin_inset Formula $\tilde{x}$
\end_inset

 from the electrode-average solid stoichiometry
\end_layout

\begin_layout Itemize
Deep within the appendices of my Master's thesis,
 there is an expression for the dc gain of 
\begin_inset Formula $\bar{\theta}_{\mathrm{s}}(\tilde{x})$
\end_inset


\end_layout

\begin_layout Itemize
Assuming 
\begin_inset Formula $\bar{C}_{\mathrm{dl}}\ll\bar{C}_{\mathrm{s}}$
\end_inset

,
 the dc gain is:
\begin_inset Formula 
\begin{align*}
\frac{\bar{\theta}_{\mathrm{s}}(\tilde{x})}{I_{\mathrm{app}}} & =\frac{1}{U_{\mathrm{ocp}}'(\theta_{\mathrm{s,avg}})}\left[\frac{1}{6\bar{\sigma}}-\frac{1+\bar{W}}{3\bar{\kappa}}\right.\\
 & \quad\left.+\left(\frac{2}{\bar{\sigma}}+\frac{3}{\bar{\kappa}}-\frac{1}{2}\left\{ \frac{1}{\bar{\sigma}}+\frac{1}{\bar{\kappa}}\right\} \left(\tilde{x}+3\right)-\frac{\bar{W}}{2\bar{\kappa}}\left(\tilde{x}-3\right)\right)\left(\tilde{x}-1\right)\right]
\end{align*}

\end_inset


\end_layout

